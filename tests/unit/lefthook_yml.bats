#!/usr/bin/env bats

# lefthook.yml is generated by set-and-setting and copied over the tracked
# file on every devShell entry. checks.lefthook-yml-generated asserts the
# tracked file equals the generator's output; these tests pin the few
# properties this repository relies on regardless of the generator version.

setup() {
    load "${BATS_LIB_PATH}/bats-support/load.bash"
    load "${BATS_LIB_PATH}/bats-assert/load.bash"
}

@test "lefthook.yml pre-commit has local commands" {
    run bash -c "awk '/^pre-commit:/,/^pre-push:/' lefthook.yml | grep -q '^  commands:'"
    assert_success
}

@test "lefthook.yml pre-push has local commands" {
    run bash -c "awk '/^pre-push:/,0' lefthook.yml | grep -q '^  commands:'"
    assert_success
}

@test "lefthook.yml has no runtime remotes" {
    run grep -q '^remotes:' lefthook.yml
    assert_failure
}

@test "lefthook.yml excludes are glob lists, not silently-ignored regex strings" {
    # lefthook 2.x only honours list-of-glob excludes. A bare regex string
    # like 'exclude: \"^(SPEC)\\.md\$\"' is accepted but silently NOT applied,
    # leaking the intended-excluded files back into the hook (§B12).
    run bash -c "grep -nE '^ *exclude: *\"' lefthook.yml | wc -l | tr -d ' '"
    assert_output "0"
}

# Succeeds when STAGE defines command HOOK and its run line calls
# lefthook-HOOK as a whole word, outside a comment. The run line may be
# folded (`run: >`) onto the next lines.
stage_runs_hook='
  /^[a-z-]+:$/ { in_stage = ($0 == stage ":"); in_cmd = 0; next }
  in_stage && /^    [a-z0-9-]+:$/ { in_cmd = ($0 == "    " hook ":"); next }
  in_stage && in_cmd && $0 !~ /^ *#/ && $0 ~ ("lefthook-" hook "([^a-z0-9-]|$)") { found = 1 }
  END { exit !found }
'

@test "both hook stages run the linters restored by the set-and-setting bump" {
    for stage in pre-commit pre-push; do
        for hook in nixfmt statix deadnix shellcheck shfmt taplo; do
            run awk -v stage="$stage" -v hook="$hook" "$stage_runs_hook" lefthook.yml
            assert_success
        done
    done
}

@test "pre-push runs the bats gates" {
    for hook in bats-parse bats-unit tdd-order-bats; do
        run awk -v stage=pre-push -v hook="$hook" "$stage_runs_hook" lefthook.yml
        assert_success
    done
}

@test "the stage check fails for a hook a stage does not define" {
    run awk -v stage=pre-commit -v hook=bats-unit "$stage_runs_hook" lefthook.yml
    assert_failure
}

@test "the stage check ignores comments and longer hook names" {
    printf 'pre-commit:\n  commands:\n    taplo:\n      # run: lefthook-taplo\n      run: lefthook-taplo-extra {staged_files}\n' >"$BATS_TEST_TMPDIR/lefthook.yml"
    run awk -v stage=pre-commit -v hook=taplo "$stage_runs_hook" "$BATS_TEST_TMPDIR/lefthook.yml"
    assert_failure
}

@test "flake defines the lefthook-yml-generated check" {
    run grep -F 'lefthook-yml-generated =' nix/outputs.nix
    assert_success
}
